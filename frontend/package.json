{
  "name": "rowsetta-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "forecast-web": "file:vendor/forecast-web-1.0.0.tgz",
    "svelte": "5.57.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/emscripten": "1.41.6",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.1",
    "markdownlint-cli2": "0.24.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "pyodide": "314.0.7",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
